# ===================================================================
# TechAxon IAM — Multi-Factor Authentication (MFA / 2FA) Test Suite
# ===================================================================
# Tests the full lifecycle of TOTP-based Two-Factor Authentication:
#  1. Normal Login (MFA disabled)
#  2. MFA Setup (Generate secret + key URI)
#  3. MFA Enable (Verify TOTP code + receive 8 backup recovery codes)
#  4. MFA Login Challenge (POST /auth/login returns mfaRequired + mfaToken)
#  5. MFA Authenticate via TOTP (POST /auth/mfa/authenticate -> access + refresh tokens)
#  6. MFA Authenticate via Backup Recovery Code (Single-use consumption)
#  7. MFA Disable (Requires password + TOTP code)
# ===================================================================

@baseUrl = http://localhost:3000
@email = saeed@example.com
@password = Password123!

# -------------------------------------------------------------------
# 1. Login User (Initial state: MFA not enabled)
# -------------------------------------------------------------------
# @name initialLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Capture the Access Token for protected setup calls
@accessToken = {{initialLogin.response.body.accessToken}}


# -------------------------------------------------------------------
# 2. MFA Setup: POST /auth/mfa/setup (Generate Secret & QR Code URI)
# -------------------------------------------------------------------
# Protected endpoint. Generates a Base32 secret and standard otpauth URI.
# @name mfaSetup
POST {{baseUrl}}/auth/mfa/setup
Authorization: Bearer {{accessToken}}
Content-Type: application/json

# EXPECTED: HTTP/1.1 200 OK
# {
#   "secret": "JBSWY3DPEHPK3PXP...",
#   "keyUri": "otpauth://totp/TechAxon:saeed%40example.com?secret=..."
# }

@mfaSecret = {{mfaSetup.response.body.secret}}


# -------------------------------------------------------------------
# 3. MFA Enable: POST /auth/mfa/enable (Confirm TOTP & Activate)
# -------------------------------------------------------------------
# Send the 6-digit code generated by the authenticator app to activate.
# @name mfaEnable
POST {{baseUrl}}/auth/mfa/enable
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "secret": "{{mfaSecret}}",
  "code": "123456"
}

# EXPECTED: HTTP/1.1 200 OK
# {
#   "success": true,
#   "message": "Two-factor authentication successfully enabled",
#   "backupCodes": [
#     "a1b2-c3d4",
#     "e5f6-g7h8",
#     ...
#   ]
# }


# -------------------------------------------------------------------
# 4. Login with MFA Active: POST /auth/login -> 200 OK (mfaRequired: true)
# -------------------------------------------------------------------
# When MFA is active, login returns an mfaToken challenge instead of full tokens.
# @name mfaLoginChallenge
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

# EXPECTED: HTTP/1.1 200 OK
# {
#   "mfaRequired": true,
#   "mfaToken": "eyJhbGciOiJIUzI1NiIsIn...",
#   "user": { ... }
# }

@mfaChallengeToken = {{mfaLoginChallenge.response.body.mfaToken}}


# -------------------------------------------------------------------
# 5. MFA Authenticate (TOTP): POST /auth/mfa/authenticate -> Tokens & Cookie
# -------------------------------------------------------------------
# Exchange the challenge token + 6-digit TOTP code for full tokens and session.
# @name mfaAuthTotp
POST {{baseUrl}}/auth/mfa/authenticate
Content-Type: application/json

{
  "mfa_token": "{{mfaChallengeToken}}",
  "code": "123456"
}

# EXPECTED: HTTP/1.1 200 OK + Set-Cookie: techaxon_refresh_token
# {
#   "accessToken": "...",
#   "refreshToken": "...",
#   "user": { ... }
# }


# -------------------------------------------------------------------
# 6. MFA Authenticate (Backup Code): POST /auth/mfa/authenticate
# -------------------------------------------------------------------
# Single-use backup code authentication when user loses device.
# @name mfaAuthBackup
POST {{baseUrl}}/auth/mfa/authenticate
Content-Type: application/json

{
  "mfa_token": "{{mfaChallengeToken}}",
  "backup_code": "a1b2-c3d4"
}

# EXPECTED: HTTP/1.1 200 OK (and the used code is permanently deleted)


# -------------------------------------------------------------------
# 7. MFA Disable: POST /auth/mfa/disable
# -------------------------------------------------------------------
# Requires account password + current TOTP code to deactivate.
# @name mfaDisable
POST {{baseUrl}}/auth/mfa/disable
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "password": "{{password}}",
  "code": "123456"
}

# EXPECTED: HTTP/1.1 200 OK
# {
#   "success": true,
#   "message": "Two-factor authentication successfully disabled"
# }
